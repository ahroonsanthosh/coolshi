# Copy to .env. Everything here is optional.

# Port for the aggregator (and the built site in production).
PORT=8080

# OpenSky Network: a free account raises the daily allowance from 400 to 4,000
# credits, which keeps the worldwide aircraft picture live most of the day.
# Create an API client at https://opensky-network.org/my-opensky/account
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Seconds between worldwide polls (default 150 anonymous, 45 with an account).
OPENSKY_POLL_S=

# AISStream: worldwide ships. Free key from https://aisstream.io (Account page).
# Without one, ships come from Fintraffic's open Baltic feed only.
AISSTREAM_API_KEY=

# Open Waters AIS: worldwide ships work without a key; a free personal
# token (https://openwaters.io/api/ais/#authentication) raises the limits.
OPENWATERS_TOKEN=

# Your own receivers (optional, free, and the best coverage there is nearby).
# ADS-B: comma-separated readsb / dump1090-fa / tar1090 aircraft.json URLs.
READSB_URLS=
# AIS: comma-separated raw NMEA streams over TCP, as Name@host:port
# (AIS-catcher, rtl-ais, a dAISy or a ship's AIS unit can serve one).
AIS_TCP_FEEDS=

# News feeds are on by default; NEWS=off turns them off.
NEWS=
